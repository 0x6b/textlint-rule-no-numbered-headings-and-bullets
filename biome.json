{
   "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
   "files": {
      "includes": ["**", "!**/lib", "!**/node_modules"]
   },
   "formatter": {
      "enabled": true,
      "indentStyle": "space",
      "indentWidth": 3,
      "lineWidth": 120
   },
   "linter": {
      "enabled": true,
      "rules": {
         "preset": "recommended"
      }
   },
   "javascript": {
      "formatter": {
         "quoteStyle": "double",
         "trailingCommas": "es5"
      }
   },
   "assist": { "actions": { "source": { "organizeImports": "on" } } },
   "overrides": [
      {
         "includes": ["package.json"],
         "formatter": {
            "indentWidth": 2
         }
      }
   ]
}
